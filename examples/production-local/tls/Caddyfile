{
  admin off
  auto_https off
  persist_config off
  # Bound active HTTP drain below the container's 70s termination allowance.
  grace_period 60s
}

https://:8443 {
  tls /etc/hookway/localhost.crt /etc/hookway/localhost.key
  reverse_proxy hookway:8080
}

https://:8444 {
  tls /etc/hookway/localhost.crt /etc/hookway/localhost.key
  reverse_proxy replay:8080
}

https://:8445 {
  tls /etc/hookway/localhost.crt /etc/hookway/localhost.key
  reverse_proxy console:8080
}
