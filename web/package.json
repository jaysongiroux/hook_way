{
  "name": "hookway-config-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.21.0 || ^26.11.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/docs/check-site.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:console": "vite --mode console",
    "preview:console": "vite preview --mode console",
    "build:console": "tsc -b && vite build --mode console",
    "test:console": "playwright test --config playwright.console.config.ts",
    "build:website": "npm run build",
    "preview:website": "npm run preview",
    "test:docs": "node --test scripts/docs/generate.test.mjs",
    "docs:inventory": "node scripts/docs/generate.mjs --dry-run"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@mantine/core": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "mermaid": "12.1.0",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.0.0",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "jsdom": "^30.1.2",
    "mdast-util-to-string": "4.0.0",
    "minimatch": "10.2.6",
    "openapi-typescript": "7.13.0",
    "parse5": "8.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "shiki": "4.5.0",
    "typescript": "^5.5.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
