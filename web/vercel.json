{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "bash ../scripts/vercel-build.sh",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/docs(?:/.*)?",
      "dest": "/docs/404.html",
      "status": 404
    },
    {
      "src": "/(?:builder|use-cases|compare)/?",
      "dest": "/index.html"
    }
  ]
}
