    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Enabled endpoints and their routing targets from loaded config.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 23 },
      "id": 14,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "hookway_endpoint_info{job=~\"$job\", instance=~\"$instance\", endpoint=~\"${endpoint:regex}\", destination_queue_id=~\"${destination:regex}\", queue=~\"${queue:regex}\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Endpoints",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true, "__name__": true },
            "indexByName": { "endpoint": 0, "destination_queue_id": 1, "queue": 2, "path": 3 },
            "renameByName": {
              "destination_queue_id": "destination",
              "endpoint": "endpoint",
              "path": "path",
              "queue": "queue"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Configured RabbitMQ (or other) destinations from loaded config.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
