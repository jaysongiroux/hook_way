# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
/hookway
/hookway-wasm
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/
docs/superpowers/
docs/scratch/
*.log
.superpowers/brainstorm/

# Generated config-UI WASM/build assets (produced by `make wasm` / `make ui`)
internal/editor/assets/*
!internal/editor/assets/.gitkeep

# Copied into the harness dir by `make wasm-harness`
cmd/hookway-wasm/harness/hookway.wasm
cmd/hookway-wasm/harness/wasm_exec.js

# Frontend (web/) build + deps
web/node_modules/
web/dist/
web/.vite/
web/playwright-report/
web/test-results/
web/blob-report/
web/public/hookway.wasm
web/public/wasm_exec.js
# tsc -b (composite build) byproducts
web/*.tsbuildinfo
web/vite.config.js
web/vite.config.d.ts

# Generated config-UI bundle for go:embed (produced by `make ui`). The whole
# directory is build output; only .gitkeep is tracked, so the `all:webui` embed
# pattern still compiles on a fresh checkout. With no bundle staged the editor
# serves the tracked internal/editor/placeholder.html instead.
internal/editor/webui/*
!internal/editor/webui/.gitkeep

# Real webhook captures used only by the V2 signature compatibility spike.
v2/spikes/fixtures/
node_modules/